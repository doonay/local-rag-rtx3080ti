* text=auto

# Source code and documentation use LF on every platform.
.dockerignore text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.conf text eol=lf

# Scripts launched directly by Windows keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Never run line-ending conversion on binary artifacts.
*.gif binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
